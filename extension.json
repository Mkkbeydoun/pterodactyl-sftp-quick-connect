{
    "$schema": "./node_modules/@pterodactyl/sdk/manifest.schema.json",
    "id": "sftp-quick-connect",
    "name": "SFTP Quick Connect",
    "version": "1.1.0",
    "description": "Open a server's files in FileZilla, WinSCP, Cyberduck or a terminal in one click, with the SFTP address and username filled in.",
    "author": "RustixDev",
    "icon": "folder-sync",
    "requires": {
        "panel": "^2.0.0-dev",
        "sdk": ">=2.0.0-beta.6 <3.0",
        "php": "^8.3"
    },
    "provider": "RustixDev\\SftpQuickConnect\\SftpQuickConnectProvider",
    "ui": {
        "entry": "dist/client.js",
        "mode": "native",
        "prefix": "rxsq",
        "screens": []
    }
}
